# ---- Backend ----
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret-before-use
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+psycopg2://netdoctor:change-this-local-password@db:5432/netdoctor
DEMO_MODE=false
CORS_ORIGINS=http://localhost:5173
HOST_AGENT_URL=http://host.docker.internal:8765
NETDOCTOR_AGENT_TOKEN=generate-a-random-secret-of-at-least-32-characters

# ---- Postgres (docker-compose) ----
POSTGRES_USER=netdoctor
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=netdoctor

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
